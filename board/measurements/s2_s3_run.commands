uptime; cat /proc/sys/kernel/random/boot_id; sha256sum /boot/BOOT.BIN /root/lean/lean_adapt.py /root/lean/lean_nc.py /root/lean/lean_calibration_flat.json; for s in /sys/bus/platform/devices/*jesd204*/status; do grep -E 'Link status|alignment error' "$s"; done; python3 -c 'from lean_stability import health,check_health; h=health(); print("TEMP",h["temperature_mc"]); check_health(h)'; echo PRE_RC=$?
cd /root/lean; python3 lean_ctl.py init --lo 3000000000 --tx-atten 4 --tx-gain 2 --rx-gain 1; echo INIT_RC=$?
cd /root/lean; python3 -c 'import lean_ctl as L; L.phy_write("out_voltage1_hardwaregain","-41.95"); print("ATT0",L.phy_read("out_voltage0_hardwaregain"),"ATT1",L.phy_read("out_voltage1_hardwaregain"),"SEL",L.tx_data_select(2,3))'; echo TX2OFF_RC=$?
cd /root/lean; python3 -c 'from lean_ctl import Core; c=Core(); c.wr(0x008,3); c.wr(0x030,(16<<20)|(720<<8)|12); print(hex(c.rd(0x030)))'; echo CFG_RC=$?
cd /root/lean; python3 lean_ctl.py rx --enable 1 --prbs 1 --reset; echo RX_RC=$?
cd /root/lean; python3 -c 'import lean_ctl as L; c=L.Core(); print("PRECHECK ver",hex(c.rd(4)),"ctrl",c.rd(8),"rxgain",c.rd(0x24),"backoff",(c.rd(0x30)>>20)&0x3F); assert c.rd(4)==0x20261025 and c.rd(8)==3 and c.rd(0x24)==1 and (c.rd(0x30)>>20)&0x3F==16'; echo PRECHECK_RC=$?
tx=; phy=; for d in /sys/bus/iio/devices/iio:device*; do n=$(cat $d/name 2>/dev/null); [ x$n = xaxi-adrv9009-tx-hpc ] && tx=$d; [ x$n = xadrv9009-phy ] && phy=$d; done; echo tx=$tx phy=$phy; echo STATE_RC=$?
cd /root/lean; printf '%s\n' 'import numpy as np,sys' 'd=np.fromfile(sys.argv[1],dtype=np.int16).astype(float); x=d[0::2]+1j*d[1::2]; N=65536; M=len(x)//N; w=np.hanning(N)' 'P=np.mean(np.abs(np.fft.fft(x[:M*N].reshape(M,N)*w,axis=1))**2,axis=0); f=np.fft.fftfreq(N,1/122.88e6); k=int(np.argmin(abs(f-16.32e6))); k=k-5+int(np.argmax(P[k-5:k+6]))' 'g=N*np.sum(w**2)*32768.0**2; print(sys.argv[1],"tone_dBFS %.2f noise_bin_dBFS %.2f tone_MHz %.4f peak_abs %d"%(10*np.log10(np.sum(P[k-4:k+5])/g),10*np.log10(np.median(P)/g),f[k]/1e6,int(np.abs(d).max())))' > /tmp/tone_meas.py; echo HELPER_RC=$?
cd /root/lean; (python3 lean_ctl.py run --bursts 400 --frames 32 --len 4096 > /tmp/e2_run.out 2>&1 &); sleep 0.5; iio_readdev -u local: -b 1048576 -s 1048576 axi-adrv9009-rx-hpc voltage0_i voltage0_q > /tmp/e2_ofdm.bin 2>/dev/null; python3 -c 'import numpy as np,sys; d=np.fromfile(sys.argv[1],dtype=np.int16).astype(float); x=d[0::2]+1j*d[1::2]; b=(np.abs(x[:len(x)//4096*4096].reshape(-1,4096))**2).mean(1); print("OFDMPWR blk_dBFS p10 %.1f p50 %.1f p90 %.1f max %.1f peak_abs %d"%(tuple(10*np.log10(np.percentile(b,[10,50,90,100])/32768**2))+(int(np.abs(d).max()),)))' /tmp/e2_ofdm.bin; while pgrep -f 'lean_ctl.py run' > /dev/null; do sleep 1; done; tail -1 /tmp/e2_run.out | cut -c1-200; echo OFDMPWR_RC=$?
cd /root/lean; printf '%s\n' 'import numpy as np,sys' 'd=np.fromfile(sys.argv[1],dtype=np.int16).astype(float); x=d[0::2]+1j*d[1::2]; N=65536; M=len(x)//N; w=np.hanning(N); f0=float(sys.argv[2])' 'P=np.mean(np.abs(np.fft.fft(x[:M*N].reshape(M,N)*w,axis=1))**2,axis=0); f=np.fft.fftfreq(N,1/122.88e6); k=int(np.argmin(abs(f-f0))); k=k-5+int(np.argmax(P[k-5:k+6]))' 'g=N*np.sum(w**2)*32768.0**2; print(sys.argv[1],"tone_dBFS %.2f noise_bin_dBFS %.2f tone_MHz %.4f peak_abs %d"%(10*np.log10(np.sum(P[k-4:k+5])/g),10*np.log10(np.median(P)/g),f[k]/1e6,int(np.abs(d).max())))' > /tmp/tone_meas2.py; echo HELPER2_RC=$?
cd /root/lean; sha256sum lean_adapt.py lean_nc.py; echo SCRIPTSHA_RC=$?
rm -f /tmp/s2_stop; echo STOPMARK_CLEARED
cd /root/lean; python3 -c 'import lean_ctl as L; from lean_stability import health; c=L.Core(); t=health()["temperature_mc"]; print("LEVELCHK rxgain",c.rd(0x24),"backoff",(c.rd(0x30)>>20)&0x3F,"temp",t); assert c.rd(0x24)==1 and (c.rd(0x30)>>20)&0x3F==16 and t<75000'; rc=$?; echo LEVELCHK_RC=$rc; [ $rc = 0 ] || touch /tmp/s2_stop
if [ -e /tmp/s2_stop ]; then echo STOPPED_OVERTEMP; else cd /root/lean; python3 lean_adapt.py --windows 75 --frames 16 --len 2048 --policy pred_olla --calibration lean_calibration_flat.json --pred-k 0 --pred-phi 0 --olla-target 0.05 --attenuation 10 11 12 13 14 15 16 17 16 15 14 13 12 11 10 --hold-windows 5 --log s2s3e1_r1_T2_S6.jsonl > s2s3e1_r1_T2_S6.stdout 2>&1; rc=$?; tail -1 s2s3e1_r1_T2_S6.jsonl | cut -c1-260; echo s2s3e1_r1_T2_S6_RC=$rc; fi
