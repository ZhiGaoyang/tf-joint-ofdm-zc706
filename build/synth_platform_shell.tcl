# Synthesize the platform shell (all BD IP out-of-context runs + top synth_1)
# from a project whose BD outputs were generated by generate_platform_outputs.tcl.
# The OFDM core stays a black box (legacy_core_stub.v); platform.tcl inserts it later.
# Optionally export constraints/clocks of a reference platform DCP for comparison.
# Args: <project_xpr> <adi_library> <fresh_receipt_dir> <jobs> [reference_dcp]
proc run_shell {} {
    global argv
    if {[version -short] ne "2023.2" || [llength $argv] < 4 || [llength $argv] > 5} {
        error "Expected Vivado 2023.2 and: project_xpr adi_library fresh_receipt_dir jobs ?reference_dcp?"
    }
    lassign $argv xpr library receipt jobs reference
    foreach name {xpr library receipt} {
        set $name [file normalize [string map {\\ /} [set $name]]]
    }
    if {![string is integer -strict $jobs] || $jobs < 1 || $jobs > 4} {error "jobs must be 1..4"}
    if {[file exists $receipt]} {error "Use a fresh receipt directory"}
    if {$reference ne ""} {
        set reference [file normalize [string map {\\ /} $reference]]
        if {![file isfile $reference]} {error "Reference DCP missing: $reference"}
    }
    file mkdir $receipt
    open_project $xpr
    set_property ip_repo_paths [list $library] [current_project]
    config_ip_cache -disable_cache
    update_ip_catalog
    if {[get_property TOP [current_fileset]] ne "system_top"} {error "Wrong physical top"}
    set bd [get_files */system.bd]
    if {[llength $bd] != 1} {error "Expected one system.bd"}
    if {![llength [get_runs -quiet -filter {IS_SYNTHESIS && SRCSET != sources_1}]]} {
        create_ip_run $bd
    }
    set top [get_runs synth_1]
    set start [clock milliseconds]
    set refresh_flag [get_property NEEDS_REFRESH $top]
    set newer {}
    set dcp [glob -nocomplain -directory [get_property DIRECTORY $top] *.dcp]
    if {[get_property STATUS $top] eq "synth_design Complete!" && [llength $dcp] == 1} {
        # NEEDS_REFRESH is also raised by project-metadata edits (e.g. reopening the XPR),
        # so decide reuse from file times: no synthesis source or constraint newer than the result.
        set built [file mtime [lindex $dcp 0]]
        foreach path [concat [get_files -compile_order sources -used_in synthesis] [get_files -of_objects [get_filesets constrs_1]]] {
            if {[file mtime $path] > $built} {lappend newer $path}
        }
    } else {
        set newer [list "<synth_1 not complete>"]
    }
    if {![llength $newer]} {
        puts "SHELL_SYNTHESIS_REUSED needs_refresh_flag=$refresh_flag"
        set reused true
    } else {
        puts "SHELL_SYNTHESIS_BEGIN jobs=$jobs stale=[llength $newer]"
        if {[get_property STATUS $top] ne "Not started"} {reset_run $top}
        launch_runs -jobs $jobs $top
        wait_on_run $top
        set reused false
    }
    set seconds [expr {([clock milliseconds] - $start) / 1000.0}]
    puts "SHELL_SYNTHESIS_END $seconds"
    set f [open "$receipt/runs.tsv" w]
    puts $f "run\tstatus\tprogress\telapsed"
    set bad {}
    foreach run [lsort [get_runs -filter {IS_SYNTHESIS}]] {
        set status [get_property STATUS $run]
        set progress [get_property PROGRESS $run]
        puts $f "$run\t$status\t$progress\t[get_property STATS.ELAPSED $run]"
        if {$status ne "synth_design Complete!" || $progress ne "100%"} {lappend bad $run}
    }
    close $f
    if {[llength $bad]} {error "Synthesis runs incomplete: $bad"}
    open_run $top
    if {[get_property PART [current_design]] ne "xc7z045ffg900-2"} {error "Unexpected part"}
    set boxes [get_cells -hier -quiet -filter {IS_BLACKBOX == 1}]
    # The module-reference OOC run uniquifies REF_NAME (system_ofdm_core_0_...);
    # ORIG_REF_NAME keeps the source module name, as in the historical relink flow.
    if {[llength $boxes] != 1 || [get_property ORIG_REF_NAME $boxes] ne "ofdm_development_core"
            || [get_property NAME $boxes] ne "i_system_wrapper/system_i/ofdm_core/inst"} {
        error "Expected exactly the OFDM core placeholder black box; got $boxes"
    }
    write_checkpoint -force "$receipt/system_top_shell.dcp"
    write_xdc -force "$receipt/shell_constraints.xdc"
    report_clocks -file "$receipt/shell_clocks.rpt"
    report_utilization -file "$receipt/shell_utilization.rpt"
    close_design
    if {$reference ne ""} {
        open_checkpoint $reference
        write_xdc -force "$receipt/reference_constraints.xdc"
        report_clocks -file "$receipt/reference_clocks.rpt"
        close_design
    }
    set f [open "$receipt/native_result.json" w]
    puts $f "{\"status\":\"SHELL_SYNTHESIS_COMPLETE\",\"synthesis_seconds\":$seconds,\"synthesis_reused\":$reused,\"needs_refresh_flag_at_open\":$refresh_flag,\"jobs\":$jobs,\"core_blackbox\":\"i_system_wrapper/system_i/ofdm_core/inst\",\"reference_exported\":[expr {$reference ne "" ? "true" : "false"}],\"implementation_executed\":false,\"hardware_acceptance\":false}"
    close $f
    close_project
}
if {[catch {run_shell} message options]} {
    puts stderr "SHELL_SYNTHESIS_FAILED: $message"
    if {[dict exists $options -errorinfo]} {puts stderr [dict get $options -errorinfo]}
    exit 1
}
exit 0
