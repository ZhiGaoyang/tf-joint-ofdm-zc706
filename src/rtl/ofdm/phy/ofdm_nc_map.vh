function [3:0] nc_popcount11;
  input [10:0] mask;
  integer i;
  begin
    nc_popcount11 = 0;
    for (i = 0; i < 11; i = i + 1) nc_popcount11 = nc_popcount11 + mask[i];
  end
endfunction

function [3:0] nc_next_unmasked;      // first unmasked group > g, 11 if none
  input [10:0] mask;
  input [3:0] g;
  integer i;
  begin
    nc_next_unmasked = 4'd11;
    for (i = 10; i >= 0; i = i - 1)
      if (i > g && !mask[i]) nc_next_unmasked = i;
  end
endfunction

function [3:0] nc_first_unmasked;
  input [10:0] mask;
